#!/usr/bin/env sh
set -eu
IMAGE="syncode-static-analysis-tools:local"
TOOL="$(basename "$0")"
WORKDIR="$(pwd)"
exec docker run --rm --network none \
  --user "$(id -u):$(id -g)" \
  -e HOME="$WORKDIR" \
  -e TMPDIR="$WORKDIR" \
  -e TMP="$WORKDIR" \
  -e TEMP="$WORKDIR" \
  -e NO_COLOR=1 \
  -e CI=1 \
  -v "$WORKDIR:$WORKDIR" \
  -w "$WORKDIR" \
  "$IMAGE" "$TOOL" "$@"
